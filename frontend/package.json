{
  "name": "todo-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "api:spec": "node scripts/fetch-openapi.mjs",
    "api:types": "openapi-typescript lib/api-spec.json -o lib/api-types.d.ts",
    "api:gen": "npm run api:spec && npm run api:types",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "next": "14.2.13",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.12.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.5.4"
  }
}
