# ── App ──────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080
# Host'a publish edilen port (çakışmasız): 18081
HOST_APP_PORT=18081
RUST_LOG=info
APP_NAME=todo-backend

# ── Database (docker-compose postgres servisi) ─────────
# Container içi DSN (servis adı ile):
DATABASE_URL=postgres://todo:todo@postgres:5432/todo
# Host'tan psql ile bağlanmak için (çakışmasız host portu 25433):
# postgres://todo:todo@127.0.0.1:25433/todo
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo
# Host'a publish edilen postgres portu (çakışmasız):
HOST_POSTGRES_PORT=25433

# ── Supabase (opsiyonel — dış Supabase kullanıyorsan doldur) ──
# Doldurulursa JWT doğrulamada SUPABASE_JWT_SECRET kullanılır,
# DATABASE_URL yerine Supabase Postgres DSN de verebilirsin.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=dev-only-change-me-min-32-chars-secret
# Supabase Auth ile uyumlu olması için JWT aud/iss kontrolü:
JWT_ISSUER=
JWT_AUDIENCE=authenticated

# ── Auth / JWT (local fallback) ────────────────────────
JWT_SECRET=dev-only-change-me-min-32-chars-secret
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30

# ── CORS / Güvenlik ────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=20

# ── Bildirim / Cron ────────────────────────────────────
DUE_SOON_HOURS=24
CHECK_DUE_CRON=0 */15 * * * *

# ── Web (Next.js) ────────────────────────────────────
HOST_WEB_PORT=3005
NEXT_PUBLIC_API_URL=http://127.0.0.1:18081
