# ── App ──────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080
HOST_APP_PORT=18081
RUST_LOG=info

# ── Dış erişim ───────────────────────────────────────
# Portların bağlanacağı adres: 0.0.0.0 = tüm arayüzler (dış IP dahil),
# 127.0.0.1 = yalnızca yerel. Güvenlik duvarı açıklarını unutmayın.
BIND_IP=0.0.0.0

# ── Database ─────────────────────────────────────────
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo
HOST_POSTGRES_PORT=25433
# Container içi DSN compose tarafından ezilir; local cargo için:
DATABASE_URL=postgres://todo:todo@127.0.0.1:25433/todo

# ── Supabase (opsiyonel) ─────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=dev-only-change-me-min-32-chars-secret-001
JWT_SECRET=dev-only-change-me-min-32-chars-secret-001
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=
JWT_AUDIENCE=authenticated

# ── Demo hesaplar (üretimde kapatın!) ────────────────
SEED_DEMO_USERS=true
DEMO_PASSWORD=demo1234

# ── CORS / Güvenlik ──────────────────────────────────
# Tarayıcı aynı origin'deki /api proxy'sini kullandığı için CORS artık kritik değil;
# yine de doğrudan API erişimi için origin'leri ekleyin.
CORS_ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=20

# ── Bildirim / Cron ──────────────────────────────────
DUE_SOON_HOURS=24
CHECK_DUE_CRON=0 */15 * * * *

# ── Web (Next.js) ────────────────────────────────────
HOST_WEB_PORT=3005
# Tarayıcı /api isteklerini web'in kendi reverse-proxy'sine (next rewrites) gönderir;
# bu değer sunucu tarafı fallback için API'nin dışarıdan erişilebilir adresidir.
NEXT_PUBLIC_API_URL=http://127.0.0.1:18081
